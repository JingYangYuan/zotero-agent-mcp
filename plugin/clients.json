      "detectPaths": [
        "~/.codex"
      ],
      "skillDir": "~/.codex/skills/zotero-agent",
      "prefer": "node",
      "note": "TOML 追加到 ~/.codex/config.toml（保留其它 [mcp_servers.*]）"
    },
    {
      "id": "gemini-cli",
