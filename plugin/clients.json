{
  "version": 1,
  "_doc": "Client registry for the Zotero-Agent-MCP settings pane. Supports merge-only auto-connect and startup sync. Users can override or extend this list with <Zotero data dir>/zotero-agent-mcp/clients.local.json (same shape, matched by id, merged on top).",
  "clients": [
    {
      "id": "claude-code",
      "label": "Claude Code",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/.claude.json"
        ],
        "linux": [
          "~/.claude.json"
        ],
        "win32": [
          "%USERPROFILE%/.claude.json"
        ]
      },
      "detectPaths": [
        "~/.claude",
        "~/.claude.json"
      ],
      "skillDir": "~/.claude/skills/zotero-agent",
      "prefer": "node",
      "note": "合并进 ~/.claude.json 顶层的 mcpServers；也可用 `claude mcp add` 注册"
    },
    {
      "id": "claude-desktop",
      "label": "Claude Desktop",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/Library/Application Support/Claude/claude_desktop_config.json"
        ],
        "linux": [
          "~/.config/Claude/claude_desktop_config.json"
        ],
        "win32": [
          "%APPDATA%/Claude/claude_desktop_config.json"
        ]
      },
      "detectPaths": [
        "~/Library/Application Support/Claude",
        "~/.config/Claude",
        "%APPDATA%/Claude",
        "/Applications/Claude.app"
      ],
      "skillDir": "",
      "prefer": "node",
      "note": "粘贴后完全退出并重启 Claude Desktop"
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/.cursor/mcp.json"
        ],
        "linux": [
          "~/.cursor/mcp.json"
        ],
        "win32": [
          "%USERPROFILE%/.cursor/mcp.json"
        ]
      },
      "detectPaths": [
        "~/.cursor",
        "/Applications/Cursor.app"
      ],
      "skillDir": "~/.cursor/skills/zotero-agent",
      "prefer": "node",
      "note": "全局配置 ~/.cursor/mcp.json；项目级用 .cursor/mcp.json"
    },
    {
      "id": "codex",
      "label": "Codex CLI",
