{
  "version": 1,
  "_doc": "Client registry for the Zotero-Agent-MCP settings pane. Read-only detection: the plugin never writes these config files, it only inspects them and generates a snippet you copy. Users can override or extend this list with <Zotero data dir>/zotero-agent-mcp/clients.local.json (same shape, matched by id, merged on top).",
  "clients": [
    {
      "id": "claude-code",
      "label": "Claude Code",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/.claude.json"
        ],
        "linux": [
          "~/.claude.json"
        ],
        "win32": [
          "%USERPROFILE%/.claude.json"
        ]
      },
      "detectPaths": [
        "~/.claude",
        "~/.claude.json"
      ],
      "skillDir": "~/.claude/skills/zotero-agent",
      "prefer": "node",
      "note": "合并进 ~/.claude.json 顶层的 mcpServers；也可用 `claude mcp add` 注册"
    },
    {
      "id": "claude-desktop",
      "label": "Claude Desktop",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/Library/Application Support/Claude/claude_desktop_config.json"
        ],
        "linux": [
          "~/.config/Claude/claude_desktop_config.json"
        ],
        "win32": [
          "%APPDATA%/Claude/claude_desktop_config.json"
        ]
      },
      "detectPaths": [
        "~/Library/Application Support/Claude",
        "~/.config/Claude",
        "%APPDATA%/Claude",
        "/Applications/Claude.app"
      ],
      "skillDir": "",
      "prefer": "node",
      "note": "粘贴后完全退出并重启 Claude Desktop"
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/.cursor/mcp.json"
        ],
        "linux": [
          "~/.cursor/mcp.json"
        ],
        "win32": [
          "%USERPROFILE%/.cursor/mcp.json"
        ]
      },
      "detectPaths": [
        "~/.cursor",
        "/Applications/Cursor.app"
      ],
      "skillDir": "~/.cursor/skills/zotero-agent",
      "prefer": "node",
      "note": "全局配置 ~/.cursor/mcp.json；项目级用 .cursor/mcp.json"
    },
    {
      "id": "codex",
      "label": "Codex CLI",
      "format": "toml-codex",
      "paths": {
        "darwin": [
          "~/.codex/config.toml"
        ],
        "linux": [
          "~/.codex/config.toml"
        ],
        "win32": [
          "%USERPROFILE%/.codex/config.toml"
        ]
      },
      "detectPaths": [
        "~/.codex"
      ],
      "skillDir": "~/.codex/skills/zotero-agent",
      "prefer": "node",
      "note": "TOML 追加到 ~/.codex/config.toml（保留其它 [mcp_servers.*]）"
    },
    {
      "id": "gemini-cli",
      "label": "Gemini CLI",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/.gemini/settings.json"
        ],
        "linux": [
          "~/.gemini/settings.json"
        ],
        "win32": [
          "%USERPROFILE%/.gemini/settings.json"
        ]
      },
      "detectPaths": [
        "~/.gemini",
        "~/.gemini/settings.json"
      ],
      "skillDir": "~/.gemini/skills/zotero-agent",
      "prefer": "npx",
      "note": "默认沙盒无文件权限，推荐 npx 命令方式"
    },
    {
      "id": "zcode",
      "label": "ZCode",
      "format": "json-zcode",
      "paths": {
        "darwin": [
          "~/.zcode/cli/config.json"
        ],
        "linux": [
          "~/.zcode/cli/config.json"
        ],
        "win32": [
          "%USERPROFILE%/.zcode/cli/config.json"
        ]
      },
      "detectPaths": [
        "~/.zcode",
        "/Applications/ZCode.app"
      ],
      "skillDir": "~/.zcode/skills/zotero-agent",
      "prefer": "node",
      "note": "合并进 ~/.zcode/cli/config.json 的 mcp.servers（保留其它 server）"
    },
    {
      "id": "vs-code",
      "label": "VS Code",
      "format": "json-vscode-servers",
      "paths": {
        "darwin": [
          "~/Library/Application Support/Code/User/mcp.json",
          "~/.vscode/mcp.json"
        ],
        "linux": [
          "~/.config/Code/User/mcp.json",
          "~/.vscode/mcp.json"
        ],
        "win32": [
          "%APPDATA%/Code/User/mcp.json",
          "%USERPROFILE%/.vscode/mcp.json"
        ]
      },
      "detectPaths": [
        "~/Library/Application Support/Code",
        "~/.config/Code",
        "%APPDATA%/Code",
        "~/.vscode",
        "/Applications/Visual Studio Code.app"
      ],
      "skillDir": "",
      "prefer": "node",
      "note": "使用 servers 键；也可放进工作区 .vscode/mcp.json"
    },
    {
      "id": "opencode",
      "label": "OpenCode",
      "format": "json-opencode",
      "paths": {
        "darwin": [
          "~/.config/opencode/opencode.json"
        ],
        "linux": [
          "~/.config/opencode/opencode.json"
        ],
        "win32": [
          "%USERPROFILE%/.config/opencode/opencode.json",
          "%APPDATA%/opencode/opencode.json"
        ]
      },
      "detectPaths": [
        "~/.config/opencode",
        "~/.opencode",
        "%APPDATA%/opencode",
        "/Applications/OpenCode.app"
      ],
      "skillDir": "",
      "prefer": "node",
      "note": "使用 mcp 键（type=local）"
    },
    {
      "id": "pi",
      "label": "Pi agent",
      "format": "json-mcpServers",
      "paths": {
        "darwin": [
          "~/.pi/agent/mcp.json"
        ],
        "linux": [
          "~/.pi/agent/mcp.json"
        ],
        "win32": [
          "%USERPROFILE%/.pi/agent/mcp.json"
        ]
      },
      "detectPaths": [
        "~/.pi/agent"
      ],
      "skillDir": "~/.pi/agent/skills/zotero-agent",
      "prefer": "node",
      "note": "合并进 ~/.pi/agent/mcp.json 的 mcpServers"
    }
  ]
}
